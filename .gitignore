# ==============================================================================
# Git Ignore - Visual Bulk Certificate Generator
# ==============================================================================

# --- Byte-compiled / optimized / DLL files ---
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so
.Python

# --- Virtual Environments ---
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# --- Application Outputs & Temp Batches ---
output_certificates/
test_output/
test_bulk_output/
test_multi_sheet_output/
test_single_page_output/
test_two_page_output/
test_robotics_lab_30_students/
*.pdf
!assets/*.pdf

# --- Uploads (Keep folder, ignore user uploaded runtime files) ---
uploads/*
!uploads/.gitkeep

# --- Logs & Debug files ---
*.log
server.log
pip-log.txt
pip-delete-this-directory.txt

# --- Binaries & Downloaded Tools ---
cloudflared.exe
*.exe
*.msi

# --- Mobile & APK build artifacts ---
android/
ios/
mobile_dist/
node_modules/
package.json
package-lock.json
capacitor.config.json
capacitor.config.ts
*.apk
*.aab

